# Copie este arquivo para .env.local e preencha (no Vercel, cadastre em Settings > Environment Variables)

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: NUNCA coloque NEXT_PUBLIC_ nela. Só o servidor usa.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site, sem barra no final (ex: https://agenda.seudominio.com.br)
# O Mercado Pago só avisa o pagamento (webhook) se for https.
APP_URL=http://localhost:3000

# Telegram: crie o bot no @BotFather
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Texto aleatório qualquer (ex: gere em um gerador de senhas). Protege o webhook do Telegram.
TELEGRAM_WEBHOOK_SECRET=

# E-mail usado só quando o cliente não informa o dele (o Mercado Pago exige um e-mail no Pix)
FALLBACK_PAYER_EMAIL=cliente@email.com
