# Copie este arquivo para .env.local e preencha (no Vercel, cadastre em Settings > Environment Variables)

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: NUNCA coloque NEXT_PUBLIC_ nela. Só o servidor usa.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do site, sem barra no final (ex: https://agenda.seudominio.com.br)
# O Mercado Pago só avisa o pagamento (webhook) se for https.
APP_URL=http://localhost:3000

# Telegram: crie o bot no @BotFather
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Texto aleatório qualquer (ex: gere em um gerador de senhas). Protege o webhook do Telegram.
TELEGRAM_WEBHOOK_SECRET=

# E-mail usado só quando o cliente não informa o dele (o Mercado Pago exige um e-mail no Pix)
FALLBACK_PAYER_EMAIL=cliente@email.com

# Opcional: seu WhatsApp (só números, com 55 e DDD) para o botão "Falar com o suporte" nos avisos do painel
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Mercado Pago OAuth (botão "Conectar com Mercado Pago"): dados da SUA aplicação em Mercado Pago Developers.
# O endereço de retorno cadastrado lá deve ser: APP_URL + /api/mp/callback
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Mensalidade paga pelas barbearias: Access Token de produção da SUA conta do Mercado Pago (onde você recebe).
# Só na Vercel, nunca no chat nem no GitHub.
PLATFORM_MP_ACCESS_TOKEN=

# Captcha (Cloudflare Turnstile). Chave do SITE (pública). Deixe vazio para desligar.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
